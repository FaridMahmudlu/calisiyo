# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Auth Client ID (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# -------------------------------------------------------------
# ANALYTICS & MONITORING CONFIGURATION
# -------------------------------------------------------------

# 1. PostHog Product Analytics & Session Recordings
# Get key from https://app.posthog.com (Project Settings -> Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=phc_example_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# 2. Sentry Error & Performance Tracking
# Get DSN from https://sentry.io (Project Settings -> Client Keys DSN)
NEXT_PUBLIC_SENTRY_DSN=https://example@o12345.ingest.sentry.io/123456

# 3. Google Analytics 4 (GA4)
# Get Measurement ID from Google Analytics (Data Streams -> G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
