# Shopier merchant configuration. Server-only: never prefix secrets with NEXT_PUBLIC_.
SHOPIER_ACCESS_TOKEN=your-shopier-personal-access-token
SHOPIER_PRODUCT_ID_2027=your-shopier-product-id
SHOPIER_PRODUCT_ID_2028=your-shopier-product-id
