# -------------------------------------------------------------
# BILLING & LEGAL (server-only; never prefix secrets with NEXT_PUBLIC_)
# -------------------------------------------------------------
# Required before paid checkout is enabled.
CALISIYO_LEGAL_NAME=your-registered-name-or-company
CALISIYO_TAX_OR_MERSIS_NUMBER=your-tax-or-mersis-number
CALISIYO_SUPPORT_EMAIL=your-real-support-email@example.com

# iyzico merchant API credentials. Start with sandbox, then switch all three
# values together after production approval.
IYZICO_ENVIRONMENT=sandbox
IYZICO_API_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key

# Server-only Supabase key used only after iyzico has confirmed a unique sale.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
