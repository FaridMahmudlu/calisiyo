# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Auth Client ID (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# YouTube Data API v3 (Optional, recommended for high-volume playlist imports)
# The app has a public-metadata fallback for normal use; keep this server-only.
YOUTUBE_API_KEY=your-server-side-youtube-data-api-key

